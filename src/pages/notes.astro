---
import { getCollection } from 'astro:content';
import ArchiveIndexLayout from '../layouts/ArchiveIndexLayout.astro';

const entries = await getCollection(
  'entries',
  ({ data }) => !data.draft && data.kind === 'note'
);

entries.sort(
  (a, b) => b.data.published.getTime() - a.data.published.getTime()
);
---

<ArchiveIndexLayout
  title="Notes"
  description="Fragments, observations, short entries and unfinished lines of inquiry."
  entries={entries}
  kind="note"
/>
