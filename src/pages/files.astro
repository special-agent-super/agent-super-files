---
import { getCollection } from 'astro:content';
import ArchiveIndexLayout from '../layouts/ArchiveIndexLayout.astro';

const entries = await getCollection(
  'entries',
  ({ data }) => !data.draft && data.kind === 'file'
);

entries.sort(
  (a, b) => b.data.published.getTime() - a.data.published.getTime()
);
---

<ArchiveIndexLayout
  title="Files"
  description="Investigations, histories, mixes and long-form research."
  entries={entries}
  kind="file"
/>
