---
import { getCollection } from 'astro:content';
import ArchiveIndexLayout from '../layouts/ArchiveIndexLayout.astro';

const entries = await getCollection(
  'entries',
  ({ data }) => !data.draft && data.kind === 'artifact'
);

entries.sort(
  (a, b) => b.data.published.getTime() - a.data.published.getTime()
);
---

<ArchiveIndexLayout
  title="Artifacts"
  description="Scans, physical media, ephemera, recordings and other source material."
  entries={entries}
  kind="artifact"
/>
