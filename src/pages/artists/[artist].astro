---
import '../../styles/editorial.css';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { slugify } from '../../utils/slugs';

export async function getStaticPaths() {
  const entries = await getCollection(
    'entries',
    ({ data }) => !data.draft
  );

  const artists = new Map<string, string>();

  for (const entry of entries) {
    for (const artist of entry.data.artists) {
      artists.set(slugify(artist), artist);
    }
  }

  return [...artists.entries()].map(([slug, artist]) => ({
    params: {
      artist: slug,
    },
    props: {
      artist,
    },
  }));
}

const { artist } = Astro.props;

const entries = (await getCollection(
  'entries',
  ({ data }) =>
    !data.draft &&
    data.artists.some(
      (entryArtist) => slugify(entryArtist) === slugify(artist)
    )
)).sort(
  (a, b) => b.data.published.getTime() - a.data.published.getTime()
);

function entryUrl(entry: CollectionEntry<'entries'>) {
  const section =
    entry.data.kind === 'file'
      ? 'files'
      : entry.data.kind === 'note'
      ? 'notes'
      : 'artifacts';

  return `/${section}/${entry.id}/`;
}

function archiveNumber(entry: CollectionEntry<'entries'>) {
  if (entry.data.fileNo === undefined) return null;

  return String(entry.data.fileNo).padStart(4, '0');
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{artist} — Agent Super Files</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&family=Source+Serif+4:wght@400;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="taxonomy-page">
      <div class="topline"><a href="/" class="mark">ASF</a><span>AN IRREGULAR ARCHIVE OF ELECTRONIC MUSIC.</span></div>
      <header class="site-header">
        <a href="/" class="site-title">Agent Super Files</a>
        <nav aria-label="Main navigation"><a href="/files/">FILES</a><a href="/notes/">NOTES</a><a href="/artifacts/">ARTIFACTS</a></nav>
      </header>
      <main>
        <header class="taxonomy-heading">
          <small>ARTIST INDEX</small>
          <h1>{artist}</h1>
          <p>{entries.length} {entries.length === 1 ? 'entry' : 'entries'}</p>
        </header>
        <ul>
          {entries.map((entry) => (
            <li>
              <span>{entry.data.kind.toUpperCase()} {archiveNumber(entry)}</span>
              <a href={entryUrl(entry)}>{entry.data.title}</a>
            </li>
          ))}
        </ul>
      </main>
      <footer><span>AGENT SUPER FILES © {new Date().getFullYear()}</span><a href="/">INDEX</a></footer>
    </div>
  </body>
</html>
