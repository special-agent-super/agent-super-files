---
import '../styles/editorial.css';
import type { CollectionEntry } from 'astro:content';
import StatusBadge from '../components/StatusBadge.astro';
import RelatedEntries from '../components/RelatedEntries.astro';
import { slugify } from '../utils/slugs';

interface Props {
  entry: CollectionEntry<'entries'>;
}

const { entry } = Astro.props;
const { data } = entry;

const archiveNumber =
  data.fileNo !== undefined
    ? String(data.fileNo).padStart(4, '0')
    : null;

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en-GB', {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
  }).format(date);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />

    <title>{data.title} — Agent Super Files</title>
    <meta name="description" content={data.description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&family=Source+Serif+4:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <div class="page">

      <div class="topline">
        <a href="/" class="mark">ASF</a>
        <span>AN IRREGULAR ARCHIVE OF ELECTRONIC MUSIC.</span>
        <span>LOST RECORDINGS / OBSCURE RELEASES / UNNECESSARY RESEARCH</span>
      </div>

      <header class="site-header">
        <a href="/" class="site-title">Agent Super Files</a>

        <nav aria-label="Main navigation">
          <a href="/files/">FILES</a>
          <a href="/notes/">NOTES</a>
          <a href="/artifacts/">ARTIFACTS</a>
        </nav>
      </header>

      <main>

        <header class="entry-header">

          <div class="entry-kicker">
            <span>
              {data.kind.toUpperCase()}
              {archiveNumber && ` ${archiveNumber}`}
            </span>

            <StatusBadge status={data.status} />

            {data.format && <span>{data.format.toUpperCase()}</span>}
          </div>

          <h1>{data.title}</h1>

          <p class="dek">{data.description}</p>

          <div class="entry-info">

            <div class="entry-summary">
              <div class="summary-label">ARCHIVE RECORD</div>

              <div class="summary-number">
                {archiveNumber ?? '—'}
              </div>
            </div>

            <dl>
              <div>
                <dt>Status</dt>
                <dd>{data.status}</dd>
              </div>

              {data.format && (
                <div>
                  <dt>Format</dt>
                  <dd>{data.format}</dd>
                </div>
              )}

              <div>
                <dt>Published</dt>
                <dd>{formatDate(data.published)}</dd>
              </div>

              {data.updated && (
                <div>
                  <dt>Updated</dt>
                  <dd>{formatDate(data.updated)}</dd>
                </div>
              )}

              {data.artists.length > 0 && (
                <div>
                  <dt>Artists</dt>
                  <dd>
                    {data.artists.map((artist, index) => (
                      <>
                        {index > 0 && ', '}
                        <a href={`/artists/${slugify(artist)}/`}>
                          {artist}
                        </a>
                      </>
                    ))}
                  </dd>
                </div>
              )}

              {data.years.length > 0 && (
                <div>
                  <dt>Years</dt>
                  <dd>{data.years.join(', ')}</dd>
                </div>
              )}

              {data.labels.length > 0 && (
                <div>
                  <dt>Labels</dt>
                  <dd>{data.labels.join(', ')}</dd>
                </div>
              )}

              {data.scenes.length > 0 && (
                <div>
                  <dt>Scenes</dt>
                  <dd>{data.scenes.join(', ')}</dd>
                </div>
              )}

              {data.topics.length > 0 && (
                <div>
                  <dt>Topics</dt>
                  <dd>
                    {data.topics.map((topic, index) => (
                      <>
                        {index > 0 && ', '}
                        <a href={`/topics/${slugify(topic)}/`}>
                          {topic}
                        </a>
                      </>
                    ))}
                  </dd>
                </div>
              )}
            </dl>
          </div>

        </header>

        <article class="article">
          <slot />
        </article>

        {data.related.length > 0 && <section class="related">
          <div class="related-heading">
            <span>RELATED MATERIAL</span>
          </div>

          <RelatedEntries related={data.related} />
        </section>}

      </main>

      <footer>
        <span>AGENT SUPER FILES © {new Date().getFullYear()}</span>
        <a href="/">INDEX</a>
      </footer>

    </div>
  </body>
</html>
