---
import { getCollection } from 'astro:content';

const entries = await getCollection(
  'entries',
  ({ data }) => !data.draft && data.kind === 'note'
);

entries.sort(
  (a, b) => b.data.published.getTime() - a.data.published.getTime()
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Notes — Agent Super Files</title>
  </head>

  <body>
    <main>
      <h1>Notes</h1>

      {entries.length === 0 ? (
        <p>No notes yet.</p>
      ) : (
        <ul>
          {entries.map((entry) => (
            <li>
              <a href={`/notes/${entry.id}/`}>
                {entry.data.title}
              </a>
            </li>
          ))}
        </ul>
      )}
    </main>
  </body>
</html>
